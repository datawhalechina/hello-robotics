<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="g2_right_arm">
  <xacro:macro name="inertial_small">
    <inertial><mass value="0.5"/><origin xyz="0 0 0"/><inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/></inertial>
  </xacro:macro>
  <xacro:macro name="joint_visual" params="color:='0.72 0.75 0.80 1'">
    <visual><geometry><sphere radius="0.065"/></geometry><material name="joint_color"><color rgba="${color}"/></material></visual>
  </xacro:macro>
  <xacro:macro name="joint_ball" params="color:='0.72 0.75 0.80 1'">
    <xacro:joint_visual color="${color}"/>
    <collision><geometry><sphere radius="0.060"/></geometry></collision>
    <xacro:inertial_small/>
  </xacro:macro>

  <link name="arm_base_link">
    <visual><origin xyz="-0.12 0 0"/><geometry><box size="0.34 0.52 0.45"/></geometry><material name="body"><color rgba="0.24 0.26 0.30 1"/></material></visual>
    <collision><origin xyz="-0.12 0 0"/><geometry><box size="0.34 0.52 0.45"/></geometry></collision>
  </link>

  <link name="arm_r_link1">
    <xacro:joint_ball/>
    <!-- visual 连接当前 joint1 到下一个 joint2；只修显示，不改变碰撞体。 -->
    <visual><origin xyz="0 0 0.08725"/><geometry><cylinder radius="0.055" length="0.1745"/></geometry><material name="arm"><color rgba="0.86 0.88 0.92 1"/></material></visual>
  </link>
  <joint name="idx61_arm_r_joint1" type="revolute">
    <parent link="arm_base_link"/><child link="arm_r_link1"/>
    <origin xyz="0 0 -0.069" rpy="${pi} 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-3.1067" upper="3.1067" effort="108" velocity="3.1416"/>
  </joint>
  <link name="arm_r_link2">
    <xacro:joint_visual/>
    <collision><origin xyz="0 0 0.08725"/><geometry><cylinder radius="0.052" length="0.1745"/></geometry></collision><xacro:inertial_small/>
  </link>
  <joint name="idx62_arm_r_joint2" type="revolute">
    <parent link="arm_r_link1"/><child link="arm_r_link2"/>
    <origin xyz="0 0 0.1745" rpy="${pi/2} 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-2.0944" upper="2.0944" effort="108" velocity="3.1416"/>
  </joint>
  <link name="arm_r_link3">
    <xacro:joint_ball/>
    <!-- joint3 -> joint4 = (0.018, 0, 0.287)。 -->
    <visual><origin xyz="0.009 0 0.1435" rpy="0 0.06264 0"/><geometry><cylinder radius="0.052" length="0.287564"/></geometry><material name="arm2"><color rgba="0.72 0.76 0.84 1"/></material></visual>
  </link>
  <joint name="idx63_arm_r_joint3" type="revolute">
    <parent link="arm_r_link2"/><child link="arm_r_link3"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-3.1067" upper="3.1067" effort="36" velocity="3.1416"/>
  </joint>
  <link name="arm_r_link4">
    <xacro:joint_visual/>
    <collision><origin xyz="0.009 0 0.1435"/><geometry><cylinder radius="0.050" length="0.287"/></geometry></collision><xacro:inertial_small/>
  </link>
  <joint name="idx64_arm_r_joint4" type="revolute">
    <parent link="arm_r_link3"/><child link="arm_r_link4"/>
    <origin xyz="0.018 0 0.287" rpy="${pi/2} 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-2.5307" upper="1.0472" effort="36" velocity="3.1416"/>
  </joint>
  <link name="arm_r_link5">
    <xacro:joint_ball/>
    <!-- visual 连接 joint5 到 joint6。 -->
    <visual><origin xyz="0 0 0.157"/><geometry><cylinder radius="0.046" length="0.314"/></geometry><material name="arm3"><color rgba="0.86 0.88 0.92 1"/></material></visual>
  </link>
  <joint name="idx65_arm_r_joint5" type="revolute">
    <parent link="arm_r_link4"/><child link="arm_r_link5"/>
    <origin xyz="-0.018 0 0" rpy="${-pi/2} 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-3.1067" upper="3.1067" effort="18" velocity="3.1416"/>
  </joint>
  <link name="arm_r_link6">
    <xacro:joint_visual/>
    <collision><origin xyz="0 0 0.157"/><geometry><cylinder radius="0.044" length="0.314"/></geometry></collision><xacro:inertial_small/>
  </link>
  <joint name="idx66_arm_r_joint6" type="revolute">
    <parent link="arm_r_link5"/><child link="arm_r_link6"/>
    <origin xyz="0 0 0.314" rpy="${pi/2} 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-1.0472" upper="1.0472" effort="18" velocity="3.1416"/>
  </joint>
  <link name="arm_r_link7">
    <xacro:joint_ball/>
    <!-- visual 连接 joint7 到 gripper_r_center_link，圆柱默认沿 Z，绕 Y 转到 X。 -->
    <visual><origin xyz="0.118225 0 0" rpy="0 ${pi/2} 0"/><geometry><cylinder radius="0.040" length="0.23645"/></geometry><material name="arm"><color rgba="0.86 0.88 0.92 1"/></material></visual>
  </link>
  <joint name="idx67_arm_r_joint7" type="revolute">
    <parent link="arm_r_link6"/><child link="arm_r_link7"/>
    <origin xyz="0 0 0" rpy="${pi/2} 0 ${pi/2}"/><axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="18" velocity="3.1416"/>
  </joint>
  <link name="gripper_r_center_link">
    <visual><origin xyz="0 0 0"/><geometry><box size="0.11 0.10 0.12"/></geometry><material name="gripper"><color rgba="0.18 0.22 0.28 1"/></material></visual>
    <collision><origin xyz="0 0 0"/><geometry><box size="0.10 0.08 0.09"/></geometry></collision><xacro:inertial_small/>
  </link>
  <joint name="gripper_r_center_joint" type="fixed">
    <parent link="arm_r_link7"/><child link="gripper_r_center_link"/>
    <origin xyz="0.23645 0 0" rpy="${pi} ${-pi/2} 0"/>
  </joint>
</robot>
